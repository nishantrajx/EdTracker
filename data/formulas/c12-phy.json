          "label": "Mirror magnification",
          "tex": "m=\\frac{h_i}{h_o}=-\\frac vu",
          "unit": "dimensionless"
        },
        {
          "label": "Refractive index",
          "tex": "n=\\frac cv",
          "unit": "dimensionless"
        },
        {
          "label": "Snell's law",
          "tex": "n_1\\sin i=n_2\\sin r",
          "unit": "dimensionless"
        },
        {
          "label": "Critical angle",
          "tex": "\\sin C=\\frac{n_2}{n_1}\\quad(n_1>n_2)",
          "unit": "dimensionless"
        },
        {
          "label": "Lens formula",
          "tex": "\\frac1f=\\frac1v-\\frac1u",
          "unit": "m^{-1}"
        },
        {
          "label": "Lens magnification",
          "tex": "m=\\frac{h_i}{h_o}=\\frac vu",
          "unit": "dimensionless"
        },
        {
          "label": "Lens maker's formula",
          "tex": "\\frac1f=(\\mu-1)\\left(\\frac1{R_1}-\\frac1{R_2}\\right)",
          "unit": "m^{-1}"
        },
        {
          "label": "Power of lens",
          "tex": "P=\\frac1f",
          "unit": "D"
        },
        {
          "label": "Lenses in contact",
          "tex": "P=P_1+P_2+\\cdots",
          "unit": "D"
        },
        {
          "label": "Prism relation",
          "tex": "A=r_1+r_2",
          "unit": "rad"
        },
        {
          "label": "Minimum deviation",
          "tex": "\\delta_m=i+e-A\\quad\\text{and at minimum deviation }i=e",
          "unit": "rad"
        },
        {
          "label": "Prism refractive-index relation at minimum deviation",
          "tex": "\\mu=\\frac{\\sin\\left(\\frac{A+\\delta_m}{2}\\right)}{\\sin\\left(\\frac A2\\right)}",
          "unit": "dimensionless"
        }
      ]
    },
    {
      "id": "c12-phy-10",
      "formulas": [
        {
          "label": "Young's double-slit fringe width",
          "tex": "\\beta=\\frac{\\lambda D}{d}",
