{
  "subject": "c12-phy",
  "chapters": [
    {
      "id": "c12-phy-01",
      "formulas": [
        {
          "label": "Coulomb's law",
          "tex": "\\vec F=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q_1q_2}{r^2}\\hat r",
          "unit": "N"
        },
        {
          "label": "Electric field due to point charge",
          "tex": "\\vec E=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q}{r^2}\\hat r",
          "unit": "N C^{-1}"
        },
        {
          "label": "Electric dipole moment",
          "tex": "\\vec p=q\\,(2\\vec a)",
          "unit": "C m"
        },
        {
          "label": "Torque on electric dipole",
          "tex": "\\vec\\tau=\\vec p\\times\\vec E",
          "unit": "N m"
        },
        {
          "label": "Electric flux",
          "tex": "\\Phi_E=\\vec E\\cdot\\vec A=EA\\cos\\theta",
          "unit": "N m^2 C^{-1}"
        },
        {
          "label": "Gauss's law",
          "tex": "\\oint\\vec E\\cdot d\\vec A=\\frac{q_{\\rm enclosed}}{\\varepsilon_0}",
          "unit": "N m^2 C^{-1}"
        },
        {
          "label": "Field of infinite line charge",
          "tex": "E=\\frac{\\lambda}{2\\pi\\varepsilon_0r}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Field of infinite plane sheet",
          "tex": "E=\\frac{\\sigma}{2\\varepsilon_0}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Electric field of uniformly charged spherical shell",
          "tex": "E=\\begin{cases}0,&r<R\\\\\\dfrac{1}{4\\pi\\varepsilon_0}\\dfrac{Q}{r^2},&r\\ge R\\end{cases}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Dipole field on axial line (short dipole)",
          "tex": "E_{\\rm axial}=\\frac{1}{4\\pi\\varepsilon_0}\\frac{2p}{r^3}\\quad(r\\gg a)",
          "unit": "N C^{-1}"
        },
        {
          "label": "Dipole field on equatorial line (short dipole)",
          "tex": "E_{\\rm equatorial}=\\frac{1}{4\\pi\\varepsilon_0}\\frac{p}{r^3}\\quad(r\\gg a)",
          "unit": "N C^{-1}"
        },
        {
          "label": "Electric field due to electric dipole at general point (exact)",
          "tex": "\\vec E=\\frac{1}{4\\pi\\varepsilon_0}\\left[\\frac{3(\\vec p\\cdot\\hat r)\\hat r-\\vec p}{r^3}\\right]",
          "unit": "N C^{-1}"
        },
        {
          "label": "Electric dipole moment magnitude",
          "tex": "p=q(2a)",
          "unit": "C m"
        }
      ]
    },
    {
      "id": "c12-phy-02",
      "formulas": [
        {
          "label": "Electric potential",
          "tex": "V=\\frac{W}{q}",
          "unit": "V"
        },
        {
          "label": "Potential due to point charge",
          "tex": "V=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q}{r}",
          "unit": "V"
        },
        {
          "label": "Potential due to electric dipole",
          "tex": "V=\\frac{1}{4\\pi\\varepsilon_0}\\frac{p\\cos\\theta}{r^2}\\quad(r\\gg a)",
          "unit": "V"
        },
        {
          "label": "Potential due to a system of charges",
          "tex": "V=\\frac{1}{4\\pi\\varepsilon_0}\\sum_i\\frac{q_i}{r_i}",
          "unit": "V"
        },
        {
          "label": "Electric field-potential relation",
          "tex": "E=-\\frac{dV}{dr}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Potential energy of two charges",
          "tex": "U=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q_1q_2}{r_{12}}",
          "unit": "J"
        },
        {
          "label": "Potential energy of charge in external potential",
          "tex": "U=qV",
          "unit": "J"
        },
        {
          "label": "Potential energy of dipole",
          "tex": "U=-\\vec p\\cdot\\vec E=-pE\\cos\\theta",
          "unit": "J"
        },
        {
          "label": "Capacitance definition",
          "tex": "C=\\frac{Q}{V}",
          "unit": "F"
        },
        {
          "label": "Parallel-plate capacitor",
          "tex": "C=\\frac{\\varepsilon_0A}{d}",
          "unit": "F"
        },
        {
          "label": "Parallel-plate capacitor with dielectric",
          "tex": "C=\\frac{K\\varepsilon_0A}{d}=KC_0",
          "unit": "F"
        },
        {
          "label": "Capacitors in parallel",
          "tex": "C_{\\rm eq}=C_1+C_2+\\cdots",
          "unit": "F"
        },
        {
          "label": "Capacitors in series",
          "tex": "\\frac1{C_{\\rm eq}}=\\frac1{C_1}+\\frac1{C_2}+\\cdots",
          "unit": "F"
        },
        {
          "label": "Energy stored in capacitor",
          "tex": "U=\\frac12CV^2=\\frac{Q^2}{2C}=\\frac12QV",
          "unit": "J"
        },
        {
          "label": "Potential difference",
          "tex": "V_B-V_A=-\\int_A^B\\vec E\\cdot d\\vec l",
          "unit": "V"
        },
        {
          "label": "Capacitance with dielectric constant",
          "tex": "K=\\frac{C}{C_0}",
          "unit": "dimensionless"
        },
        {
          "label": "Energy density of electric field",
          "tex": "u_E=\\frac12\\varepsilon_0E^2",
          "unit": "J m^{-3}"
        }
      ]
    },
    {
      "id": "c12-phy-03",
      "formulas": [
        {
          "label": "Current",
          "tex": "I=\\frac{dq}{dt}",
          "unit": "A"
        },
        {
          "label": "Current density",
          "tex": "j=\\frac{I}{A}",
          "unit": "A m^{-2}"
        },
        {
          "label": "Drift current relation",
          "tex": "I=neAv_d",
          "unit": "A"
        },
        {
          "label": "Drift velocity",
          "tex": "v_d=\\frac{eE\\tau}{m}",
          "unit": "m s^{-1}"
        },
        {
          "label": "Mobility",
          "tex": "\\mu=\\frac{v_d}{E}=\\frac{e\\tau}{m}",
          "unit": "m^2 V^{-1}s^{-1}"
        },
        {
          "label": "Ohm's law",
          "tex": "V=IR",
          "unit": "V"
        },
        {
          "label": "Resistance of a conductor",
          "tex": "R=\\rho\\frac{L}{A}",
          "unit": "\\Omega"
        },
        {
          "label": "Current density and electric field",
          "tex": "\\vec j=\\sigma\\vec E=\\frac{\\vec E}{\\rho}",
          "unit": "A m^{-2}"
        },
        {
          "label": "Conductivity",
          "tex": "\\sigma=ne\\mu=\\frac{ne^2\\tau}{m}",
          "unit": "S m^{-1}"
        },
        {
          "label": "Resistivity-conductivity relation",
          "tex": "\\rho=\\frac1\\sigma",
          "unit": "\\Omega m"
        },
        {
          "label": "Temperature dependence of resistivity",
          "tex": "\\rho_T=\\rho_0[1+\\alpha(T-T_0)]",
          "unit": "\\Omega m"
        },
        {
          "label": "Electrical power",
          "tex": "P=VI=I^2R=\\frac{V^2}{R}",
          "unit": "W"
        },
        {
          "label": "Electrical energy",
          "tex": "W=Pt=VIt",
          "unit": "J"
        },
        {
          "label": "Cell terminal voltage",
          "tex": "V=\\mathcal E-Ir",
          "unit": "V"
        },
        {
          "label": "External load voltage",
          "tex": "V=IR=\\frac{\\mathcal E R}{R+r}",
          "unit": "V"
        },
        {
          "label": "Cells in series (identical cells)",
          "tex": "\\mathcal E_{\\rm eq}=n\\mathcal E,\\quad r_{\\rm eq}=nr",
          "unit": "V, \\Omega"
        },
        {
          "label": "Identical cells in parallel",
          "tex": "\\mathcal E_{\\rm eq}=\\mathcal E,\\quad r_{\\rm eq}=\\frac{r}{n}",
          "unit": "V, \\Omega"
        },
        {
          "label": "Kirchhoff junction rule",
          "tex": "\\sum I_{\\rm in}=\\sum I_{\\rm out}",
          "unit": "A"
        },
        {
          "label": "Kirchhoff loop rule",
          "tex": "\\sum \\Delta V=0",
          "unit": "V"
        },
        {
          "label": "Wheatstone bridge balance",
          "tex": "\\frac{P}{Q}=\\frac{R}{S}",
          "unit": "dimensionless"
        },
        {
          "label": "Resistors in series",
          "tex": "R_{\\rm eq}=R_1+R_2+\\cdots",
          "unit": "\\Omega"
        },
        {
          "label": "Resistors in parallel",
          "tex": "\\frac1{R_{\\rm eq}}=\\frac1{R_1}+\\frac1{R_2}+\\cdots",
          "unit": "\\Omega^{-1}"
        },
        {
          "label": "Metre bridge balance condition",
          "tex": "\\frac{R}{S}=\\frac{l}{100-l}",
          "unit": "dimensionless"
        },
        {
          "label": "Potentiometer potential gradient",
          "tex": "k=\\frac{V}{L}",
          "unit": "V m^{-1}"
        },
        {
          "label": "EMF by potentiometer",
          "tex": "\\frac{\\mathcal E_1}{\\mathcal E_2}=\\frac{l_1}{l_2}",
          "unit": "dimensionless"
        },
        {
          "label": "Internal resistance by potentiometer",
          "tex": "r=R\\frac{l_1-l_2}{l_2}",
          "unit": "\\Omega"
        }
      ]
    },
    {
      "id": "c12-phy-04",
      "formulas": [
        {
          "label": "Lorentz force",
          "tex": "\\vec F=q(\\vec E+\\vec v\\times\\vec B)",
          "unit": "N"
        },
        {
          "label": "Magnetic force on charge",
          "tex": "F=qvB\\sin\\theta",
          "unit": "N"
        },
        {
          "label": "Radius of charged-particle circular path",
          "tex": "r=\\frac{mv}{qB}",
          "unit": "m"
        },
        {
          "label": "Biot-Savart law",
          "tex": "d\\vec B=\\frac{\\mu_0}{4\\pi}\\frac{I\\,d\\vec l\\times\\hat r}{r^2}",
          "unit": "T"
        },
        {
          "label": "Field at centre of circular coil",
          "tex": "B=\\frac{\\mu_0NI}{2R}",
          "unit": "T"
        },
        {
          "label": "Ampere's circuital law",
          "tex": "\\oint\\vec B\\cdot d\\vec l=\\mu_0 I_{\\rm enclosed}",
          "unit": "T m"
        },
        {
          "label": "Field of long straight current-carrying wire",
          "tex": "B=\\frac{\\mu_0I}{2\\pi R}",
          "unit": "T"
        },
        {
          "label": "Field inside long solenoid",
          "tex": "B=\\mu_0nI",
          "unit": "T"
        },
        {
          "label": "Force on current-carrying conductor",
          "tex": "\\vec F=I\\vec L\\times\\vec B",
          "unit": "N"
        },
        {
          "label": "Force between parallel currents",
          "tex": "\\frac{F}{L}=\\frac{\\mu_0I_1I_2}{2\\pi d}",
          "unit": "N m^{-1}"
        },
        {
          "label": "Torque on current loop",
          "tex": "\\vec\\tau=\\vec m\\times\\vec B",
          "unit": "N m"
        },
        {
          "label": "Magnetic dipole moment of current loop",
          "tex": "\\vec m=NI\\vec A",
          "unit": "A m^2"
        },
        {
          "label": "Current sensitivity of galvanometer",
          "tex": "S_i=\\frac{\\theta}{I}=\\frac{NBA}{k}",
          "unit": "rad A^{-1}"
        },
        {
          "label": "Galvanometer to ammeter",
          "tex": "S=\\frac{I_gG}{I-I_g}",
          "unit": "\\Omega"
        },
        {
          "label": "Galvanometer to voltmeter",
          "tex": "R=\\frac{V}{I_g}-G",
          "unit": "\\Omega"
        },
        {
          "label": "Cyclotron angular frequency",
          "tex": "\\omega_c=\\frac{qB}{m}",
          "unit": "rad s^{-1}"
        },
        {
          "label": "Cyclotron frequency",
          "tex": "f_c=\\frac{qB}{2\\pi m}",
          "unit": "Hz"
        },
        {
          "label": "Cyclotron time period",
          "tex": "T=\\frac{2\\pi m}{qB}",
          "unit": "s"
        },
        {
          "label": "Velocity selector condition",
          "tex": "v=\\frac{E}{B}",
          "unit": "m s^{-1}"
        },
        {
          "label": "Torque magnitude on current loop",
          "tex": "\\tau=NIAB\\sin\\theta",
          "unit": "N m"
        },
        {
          "label": "Magnetic force on current element",
          "tex": "dF=IB\\,dl\\sin\\theta",
          "unit": "N"
        }
      ]
    },
    {
      "id": "c12-phy-05",
      "formulas": [
        {
          "label": "Magnetisation",
          "tex": "\\vec M=\\frac{\\text{magnetic moment}}{\\text{volume}}",
          "unit": "A m^{-1}"
        },
        {
          "label": "Magnetic dipole moment of a current loop",
          "tex": "m=IA",
          "unit": "A m^2"
        },
        {
          "label": "Torque on magnetic dipole",
          "tex": "\\vec\\tau=\\vec m\\times\\vec B",
          "unit": "N m"
        },
        {
          "label": "Torque magnitude on magnetic dipole",
          "tex": "\\tau=mB\\sin\\theta",
          "unit": "N m"
        },
        {
          "label": "Magnetic field on axial line of short bar magnet",
          "tex": "B_{\\rm axial}=\\frac{\\mu_0}{4\\pi}\\frac{2m}{r^3}",
          "unit": "T"
        },
        {
          "label": "Magnetic field on equatorial line of short bar magnet",
          "tex": "B_{\\rm equatorial}=\\frac{\\mu_0}{4\\pi}\\frac{m}{r^3}",
          "unit": "T"
        },
        {
          "label": "Magnetisation and magnetic field relation",
          "tex": "\\vec B=\\mu_0(\\vec H+\\vec M)",
          "unit": "T"
        },
        {
          "label": "Magnetic susceptibility",
          "tex": "\\chi_m=\\frac{M}{H}",
          "unit": "dimensionless"
        },
        {
          "label": "Relative permeability",
          "tex": "\\mu_r=1+\\chi_m",
          "unit": "dimensionless"
        },
        {
          "label": "Permeability",
          "tex": "\\mu=\\mu_0\\mu_r",
          "unit": "H m^{-1}"
        }
      ]
    },
    {
      "id": "c12-phy-06",
      "formulas": [
        {
          "label": "Magnetic flux",
          "tex": "\\Phi_B=\\vec B\\cdot\\vec A=BA\\cos\\theta",
          "unit": "Wb"
        },
        {
          "label": "Faraday's law",
          "tex": "\\mathcal E=-N\\frac{d\\Phi_B}{dt}",
          "unit": "V"
        },
        {
          "label": "Motional emf",
          "tex": "\\mathcal E=Blv",
          "unit": "V"
        },
        {
          "label": "Inductance",
          "tex": "L=\\frac{N\\Phi_B}{I}",
          "unit": "H"
        },
        {
          "label": "Mutual induction",
          "tex": "\\mathcal E_1=-M_{12}\\frac{dI_2}{dt}",
          "unit": "V"
        },
        {
          "label": "Self-induced emf",
          "tex": "\\mathcal E=-L\\frac{dI}{dt}",
          "unit": "V"
        },
        {
          "label": "Self-inductance of long solenoid",
          "tex": "L=\\mu_r\\mu_0n^2Al",
          "unit": "H"
        },
        {
          "label": "AC generator emf",
          "tex": "\\mathcal E=NBA\\omega\\sin(\\omega t)",
          "unit": "V"
        },
        {
          "label": "Energy stored in an inductor",
          "tex": "U=\\frac12LI^2",
          "unit": "J"
        },
        {
          "label": "Mutual inductance relation",
          "tex": "M=\\frac{N_1\\Phi_{21}}{I_2}=\\frac{N_2\\Phi_{12}}{I_1}",
          "unit": "H"
        },
        {
          "label": "Energy density of magnetic field",
          "tex": "u_B=\\frac{B^2}{2\\mu_0}",
          "unit": "J m^{-3}"
        }
      ]
    },
    {
      "id": "c12-phy-07",
      "formulas": [
        {
          "label": "AC voltage",
          "tex": "v=v_m\\sin\\omega t",
          "unit": "V"
        },
        {
          "label": "AC current through resistor",
          "tex": "i=i_m\\sin\\omega t,\\quad i_m=\\frac{v_m}{R}",
          "unit": "A"
        },
        {
          "label": "RMS current",
          "tex": "I_{\\rm rms}=\\frac{I_0}{\\sqrt2}",
          "unit": "A"
        },
        {
          "label": "RMS voltage",
          "tex": "V_{\\rm rms}=\\frac{V_0}{\\sqrt2}",
          "unit": "V"
        },
        {
          "label": "Inductive reactance",
          "tex": "X_L=\\omega L",
          "unit": "\\Omega"
        },
        {
          "label": "Capacitive reactance",
          "tex": "X_C=\\frac1{\\omega C}",
          "unit": "\\Omega"
        },
        {
          "label": "LCR impedance",
          "tex": "Z=\\sqrt{R^2+(X_L-X_C)^2}",
          "unit": "\\Omega"
        },
        {
          "label": "LCR current amplitude",
          "tex": "I_0=\\frac{V_0}{Z}",
          "unit": "A"
        },
        {
          "label": "LCR phase angle",
          "tex": "\\tan\\phi=\\frac{X_C-X_L}{R}",
          "unit": "dimensionless"
        },
        {
          "label": "LCR current",
          "tex": "i=I_0\\sin(\\omega t+\\phi)",
          "unit": "A"
        },
        {
          "label": "Resonance condition",
          "tex": "X_L=X_C",
          "unit": "dimensionless"
        },
        {
          "label": "Resonant angular frequency",
          "tex": "\\omega_0=\\frac1{\\sqrt{LC}}",
          "unit": "rad s^{-1}"
        },
        {
          "label": "AC average power",
          "tex": "P_{\\rm av}=V_{\\rm rms}I_{\\rm rms}\\cos\\phi",
          "unit": "W"
        },
        {
          "label": "Power factor",
          "tex": "\\cos\\phi=\\frac{R}{Z}",
          "unit": "dimensionless"
        },
        {
          "label": "Transformer voltage ratio",
          "tex": "\\frac{V_s}{V_p}=\\frac{N_s}{N_p}",
          "unit": "dimensionless"
        },
        {
          "label": "Ideal transformer current ratio",
          "tex": "\\frac{I_s}{I_p}=\\frac{N_p}{N_s}",
          "unit": "dimensionless"
        },
        {
          "label": "Angular frequency",
          "tex": "\\omega=2\\pi f",
          "unit": "rad s^{-1}"
        },
        {
          "label": "AC voltage-current phase relation",
          "tex": "\\tan\\phi=\\frac{X_L-X_C}{R}",
          "unit": "dimensionless"
        },
        {
          "label": "Resonant current in series LCR circuit",
          "tex": "I_{\\rm rms,res}=\\frac{V_{\\rm rms}}{R}",
          "unit": "A"
        },
        {
          "label": "LC oscillation frequency",
          "tex": "f_0=\\frac1{2\\pi\\sqrt{LC}}",
          "unit": "Hz"
        }
      ]
    },
    {
      "id": "c12-phy-08",
      "formulas": [
        {
          "label": "Speed of electromagnetic wave in vacuum",
          "tex": "c=\\frac1{\\sqrt{\\mu_0\\varepsilon_0}}",
          "unit": "m s^{-1}"
        },
        {
          "label": "Wave relation",
          "tex": "c=\\nu\\lambda",
          "unit": "m s^{-1}"
        },
        {
          "label": "Electric and magnetic field relation in EM wave",
          "tex": "\\frac{E_0}{B_0}=c",
          "unit": "m s^{-1}"
        }
      ]
    },
    {
      "id": "c12-phy-09",
      "formulas": [
        {
          "label": "Mirror formula",
          "tex": "\\frac1f=\\frac1v+\\frac1u",
          "unit": "m^{-1}"
        },
        {
          "label": "Mirror magnification",
          "tex": "m=\\frac{h_i}{h_o}=-\\frac vu",
          "unit": "dimensionless"
        },
        {
          "label": "Refractive index",
          "tex": "n=\\frac cv",
          "unit": "dimensionless"
        },
        {
          "label": "Snell's law",
          "tex": "n_1\\sin i=n_2\\sin r",
          "unit": "dimensionless"
        },
        {
          "label": "Critical angle",
          "tex": "\\sin C=\\frac{n_2}{n_1}\\quad(n_1>n_2)",
          "unit": "dimensionless"
        },
        {
          "label": "Lens formula",
          "tex": "\\frac1f=\\frac1v-\\frac1u",
          "unit": "m^{-1}"
        },
        {
          "label": "Lens magnification",
          "tex": "m=\\frac{h_i}{h_o}=\\frac vu",
          "unit": "dimensionless"
        },
        {
          "label": "Lens maker's formula",
          "tex": "\\frac1f=(\\mu-1)\\left(\\frac1{R_1}-\\frac1{R_2}\\right)",
          "unit": "m^{-1}"
        },
        {
          "label": "Power of lens",
          "tex": "P=\\frac1f",
          "unit": "D"
        },
        {
          "label": "Lenses in contact",
          "tex": "P=P_1+P_2+\\cdots",
          "unit": "D"
        },
        {
          "label": "Prism relation",
          "tex": "A=r_1+r_2",
          "unit": "rad"
        },
        {
          "label": "Minimum deviation",
          "tex": "\\delta_m=i+e-A\\quad\\text{and at minimum deviation }i=e",
          "unit": "rad"
        },
        {
          "label": "Prism refractive-index relation at minimum deviation",
          "tex": "\\mu=\\frac{\\sin\\left(\\frac{A+\\delta_m}{2}\\right)}{\\sin\\left(\\frac A2\\right)}",
          "unit": "dimensionless"
        },
        {
          "label": "Refraction at spherical surface",
          "tex": "\\frac{n_2}{v}-\\frac{n_1}{u}=\\frac{n_2-n_1}{R}",
          "unit": "m^{-1}"
        },
        {
          "label": "Magnifying power of compound microscope (normal adjustment)",
          "tex": "M=\\frac{L}{f_o}\\frac{D}{f_e}",
          "unit": "dimensionless"
        },
        {
          "label": "Magnifying power of compound microscope (near point)",
          "tex": "M=\\frac{L}{f_o}\\left(1+\\frac{D}{f_e}\\right)",
          "unit": "dimensionless"
        },
        {
          "label": "Magnifying power of astronomical telescope (normal adjustment)",
          "tex": "M=\\frac{f_o}{f_e}",
          "unit": "dimensionless"
        },
        {
          "label": "Magnifying power of astronomical telescope (near point)",
          "tex": "M=\\frac{f_o}{f_e}\\left(1+\\frac{f_e}{D}\\right)",
          "unit": "dimensionless"
        }
      ]
    },
    {
      "id": "c12-phy-10",
      "formulas": [
        {
          "label": "Young's double-slit fringe width",
          "tex": "\\beta=\\frac{\\lambda D}{d}",
          "unit": "m"
        },
        {
          "label": "Path difference",
          "tex": "\\Delta=d\\sin\\theta\\approx\\frac{dy}{D}",
          "unit": "m"
        },
        {
          "label": "Constructive interference",
          "tex": "\\Delta=n\\lambda",
          "unit": "m"
        },
        {
          "label": "Destructive interference",
