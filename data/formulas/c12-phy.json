{
  "subject": "c12-phy",
  "chapters": [
    {
      "id": "c12-phy-01",
      "formulas": [
        {
          "label": "Coulomb's law",
          "tex": "F=\\frac{1}{4\\pi\\varepsilon_0}\\frac{|q_1q_2|}{r^2}",
          "unit": "N"
        },
        {
          "label": "Electric field due to point charge",
          "tex": "E=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q}{r^2}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Electric dipole moment",
          "tex": "\\vec p=q\\,\\vec{2a}",
          "unit": "C m"
        },
        {
          "label": "Torque on electric dipole",
          "tex": "\\tau=pE\\sin\\theta",
          "unit": "N m"
        },
        {
          "label": "Electric flux",
          "tex": "\\Phi_E=\\vec E\\cdot\\vec A=EA\\cos\\theta",
          "unit": "N m^2 C^{-1}"
        },
        {
          "label": "Gauss's law",
          "tex": "\\oint\\vec E\\cdot d\\vec A=\\frac{q_{\\rm enclosed}}{\\varepsilon_0}",
          "unit": "N m^2 C^{-1}"
        },
        {
          "label": "Field of infinite line charge",
          "tex": "E=\\frac{\\lambda}{2\\pi\\varepsilon_0r}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Field of infinite plane sheet",
          "tex": "E=\\frac{\\sigma}{2\\varepsilon_0}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Electric field of spherical shell",
          "tex": "E=\\begin{cases}0,&r<R\\\\\\dfrac{1}{4\\pi\\varepsilon_0}\\dfrac{Q}{r^2},&r\\ge R\\end{cases}",
          "unit": "N C^{-1}"
        },
        {
          "label": "Dipole field on axial line",
          "tex": "E_{\\mathrm{axial}}=\\frac{1}{4\\pi\\varepsilon_0}\\frac{2p}{r^3}\\quad(r\\gg a)",
          "unit": "N C^{-1}"
        },
        {
          "label": "Dipole field on equatorial line",
          "tex": "E_{\\mathrm{equatorial}}=\\frac{1}{4\\pi\\varepsilon_0}\\frac{p}{r^3}\\quad(r\\gg a)",
          "unit": "N C^{-1}"
        }
      ]
    },
    {
      "id": "c12-phy-02",
      "formulas": [
        {
          "label": "Electric potential",
          "tex": "V=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q}{r}",
          "unit": "V"
        },
        {
          "label": "Potential energy of two charges",
          "tex": "U=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q_1q_2}{r}",
          "unit": "J"
        },
        {
          "label": "Potential energy of dipole",
          "tex": "U=-\\vec p\\cdot\\vec E=-pE\\cos\\theta",
          "unit": "J"
        },
        {
          "label": "Capacitance definition",
          "tex": "C=\\frac{Q}{V}",
          "unit": "F"
        },
        {
          "label": "Parallel-plate capacitor",
          "tex": "C=\\frac{\\varepsilon_0A}{d}",
          "unit": "F"
        },
        {
          "label": "With dielectric",
          "tex": "C=\\frac{K\\varepsilon_0A}{d}=KC_0",
          "unit": "F"
        },
        {
          "label": "Capacitors in parallel",
          "tex": "C_{\\rm eq}=C_1+C_2+\\cdots",
          "unit": "F"
        },
        {
          "label": "Capacitors in series",
          "tex": "\\frac1{C_{\\rm eq}}=\\frac1{C_1}+\\frac1{C_2}+\\cdots",
          "unit": "F"
        },
        {
          "label": "Energy stored in capacitor",
          "tex": "U=\\frac12CV^2=\\frac{Q^2}{2C}=\\frac12QV",
          "unit": "J"
        }
      ]
    },
    {
      "id": "c12-phy-03",
      "formulas": [
        {
          "label": "Current",
          "tex": "I=\\frac{dq}{dt}",
          "unit": "A"
        },
        {
          "label": "Drift current relation",
          "tex": "I=neAv_d",
          "unit": "A"
        },
        {
          "label": "Ohm's law",
          "tex": "V=IR",
          "unit": "V"
        },
        {
          "label": "Resistance of a conductor",
          "tex": "R=\\rho\\frac{L}{A}",
          "unit": "\\Omega"
        },
        {
          "label": "Electrical power",
          "tex": "P=VI=I^2R=\\frac{V^2}{R}",
          "unit": "W"
        },
        {
          "label": "Electrical energy",
          "tex": "W=Pt=VIt",
          "unit": "J"
        },
        {
          "label": "Cell terminal voltage",
          "tex": "V=\\mathcal E-Ir",
          "unit": "V"
        },
        {
          "label": "Cells in series",
          "tex": "\\mathcal E_{\\rm eq}=n\\mathcal E,\\quad r_{\\rm eq}=nr",
          "unit": "V,\\Omega"
        },
        {
          "label": "Kirchhoff junction rule",
          "tex": "\\sum I_{\\rm in}=\\sum I_{\\rm out}",
          "unit": "A"
        },
        {
          "label": "Wheatstone bridge balance",
          "tex": "\\frac{P}{Q}=\\frac{R}{S}",
          "unit": "dimensionless"
        },
        {
          "label": "Mobility",
          "tex": "\\mu=\\frac{v_d}{E}",
          "unit": "m² V⁻¹ s⁻¹"
        },
        {
          "label": "Conductivity relation",
          "tex": "\\sigma=ne\\mu",
          "unit": "S m⁻¹"
        },
        {
          "label": "Resistivity-conductivity relation",
          "tex": "\\rho=\\frac1\\sigma",
          "unit": "Ω m"
        },
        {
          "label": "Identical cells in parallel",
          "tex": "\\mathcal E_{\\mathrm{eq}}=\\mathcal E,\\quad r_{\\mathrm{eq}}=\\frac{r}{n}",
          "unit": "V, Ω"
        }
      ]
    },
    {
      "id": "c12-phy-04",
      "formulas": [
        {
          "label": "Lorentz force",
          "tex": "\\vec F=q(\\vec E+\\vec v\\times\\vec B)",
          "unit": "N"
        },
        {
          "label": "Magnetic force on charge",
          "tex": "F=qvB\\sin\\theta",
          "unit": "N"
        },
        {
          "label": "Biot-Savart law",
          "tex": "d\\vec B=\\frac{\\mu_0}{4\\pi}\\frac{I\\,d\\vec l\\times\\hat r}{r^2}",
          "unit": "T"
        },
        {
          "label": "Field at centre of circular loop",
          "tex": "B=\\frac{\\mu_0NI}{2R}",
          "unit": "T"
        },
        {
          "label": "Force on current-carrying conductor",
          "tex": "\\vec F=I\\vec L\\times\\vec B",
          "unit": "N"
        },
        {
          "label": "Force between parallel currents",
          "tex": "\\frac{F}{L}=\\frac{\\mu_0I_1I_2}{2\\pi d}",
          "unit": "N m^{-1}"
        },
        {
          "label": "Torque on current loop",
          "tex": "\\tau=NIAB\\sin\\theta",
          "unit": "N m"
        },
        {
          "label": "Magnetic dipole moment of current loop",
          "tex": "m=NIA",
          "unit": "A m^2"
        },
        {
          "label": "Current sensitivity of galvanometer",
          "tex": "S_i=\\frac{\\theta}{I}=\\frac{NBA}{k}",
          "unit": "rad A⁻¹"
        },
        {
          "label": "Galvanometer to ammeter",
          "tex": "S=\\frac{I_gG}{I-I_g}",
          "unit": "Ω"
        },
        {
          "label": "Galvanometer to voltmeter",
          "tex": "R=\\frac{V}{I_g}-G",
          "unit": "Ω"
        }
      ]
    },
    {
      "id": "c12-phy-05",
      "formulas": [
        {
          "label": "Magnetic dipole torque",
          "tex": "\\tau=mB\\sin\\theta",
          "unit": "N m"
        },
        {
          "label": "Magnetic potential energy",
          "tex": "U=-\\vec m\\cdot\\vec B=-mB\\cos\\theta",
          "unit": "J"
        },
        {
          "label": "Magnetic dipole field on axial line",
          "tex": "B_{\\mathrm{axial}}=\\frac{\\mu_0}{4\\pi}\\frac{2m}{r^3}\\quad(r\\gg a)",
          "unit": "T"
        },
        {
          "label": "Magnetic dipole field on equatorial line",
          "tex": "B_{\\mathrm{equatorial}}=\\frac{\\mu_0}{4\\pi}\\frac{m}{r^3}\\quad(r\\gg a)",
          "unit": "T"
        },
        {
          "label": "Magnetisation",
          "tex": "M=\\frac{\\text{magnetic moment}}{\\text{volume}}",
          "unit": "A m⁻¹"
        },
        {
          "label": "Magnetic susceptibility",
          "tex": "\\chi_m=\\frac{M}{H}",
          "unit": "dimensionless"
        }
      ]
    },
    {
      "id": "c12-phy-06",
      "formulas": [
        {
          "label": "Faraday's law",
          "tex": "\\mathcal E=-\\frac{d\\Phi_B}{dt}",
          "unit": "V"
        },
        {
          "label": "Magnetic flux",
          "tex": "\\Phi_B=BA\\cos\\theta",
          "unit": "Wb"
        },
        {
          "label": "Self-inductance",
          "tex": "\\mathcal E=-L\\frac{dI}{dt}",
          "unit": "V"
        },
        {
          "label": "Energy in inductor",
          "tex": "U=\\frac12LI^2",
          "unit": "J"
        },
        {
          "label": "Mutual induction",
          "tex": "\\mathcal E_2=-M\\frac{dI_1}{dt}",
          "unit": "V"
        },
        {
          "label": "Coefficient of coupling",
          "tex": "k=\\frac{M}{\\sqrt{L_1L_2}}",
          "unit": "dimensionless"
        }
      ]
    },
    {
      "id": "c12-phy-07",
      "formulas": [
        {
          "label": "RMS current",
          "tex": "I_{\\rm rms}=\\frac{I_0}{\\sqrt2}",
          "unit": "A"
        },
        {
          "label": "RMS voltage",
          "tex": "V_{\\rm rms}=\\frac{V_0}{\\sqrt2}",
          "unit": "V"
        },
        {
          "label": "Inductive reactance",
          "tex": "X_L=\\omega L",
          "unit": "\\Omega"
        },
        {
          "label": "Capacitive reactance",
          "tex": "X_C=\\frac1{\\omega C}",
          "unit": "\\Omega"
        },
        {
          "label": "LCR impedance",
          "tex": "Z=\\sqrt{R^2+(X_L-X_C)^2}",
          "unit": "\\Omega"
        },
        {
          "label": "Resonant angular frequency",
          "tex": "\\omega_0=\\frac1{\\sqrt{LC}}",
          "unit": "rad s^{-1}"
        },
        {
          "label": "AC average power",
          "tex": "P_{\\rm av}=V_{\\rm rms}I_{\\rm rms}\\cos\\phi",
          "unit": "W"
        },
        {
          "label": "Power factor",
          "tex": "\\cos\\phi=\\frac{R}{Z}",
          "unit": "dimensionless"
        },
        {
          "label": "Phase angle in LCR circuit",
          "tex": "\\tan\\phi=\\frac{X_L-X_C}{R}",
          "unit": "dimensionless"
        },
        {
          "label": "AC voltage/current",
          "tex": "V=V_0\\sin\\omega t,\\quad I=I_0\\sin(\\omega t-\\phi)",
          "unit": "V, A"
        },
        {
          "label": "Transformer turns ratio",
          "tex": "\\frac{V_s}{V_p}=\\frac{N_s}{N_p}",
          "unit": "dimensionless"
        },
        {
          "label": "Ideal transformer current ratio",
          "tex": "\\frac{I_s}{I_p}=\\frac{N_p}{N_s}",
          "unit": "dimensionless"
        }
      ]
    },
    {
      "id": "c12-phy-08",
      "formulas": [
        {
          "label": "Speed of electromagnetic waves",
          "tex": "c=\\frac1{\\sqrt{\\mu_0\\varepsilon_0}}",
          "unit": "m s^{-1}"
        },
        {
          "label": "Wave relation",
          "tex": "c=\\nu\\lambda",
          "unit": "m s^{-1}"
        }
      ]
    },
    {
      "id": "c12-phy-09",
      "formulas": [
        {
          "label": "Mirror formula",
          "tex": "\\frac1f=\\frac1v+\\frac1u",
          "unit": "m^{-1}"
        },
        {
          "label": "Mirror magnification",
          "tex": "m=\\frac{h_i}{h_o}=-\\frac vu",
          "unit": "dimensionless"
        },
        {
          "label": "Refractive index",
          "tex": "n=\\frac cv",
          "unit": "dimensionless"
        },
        {
          "label": "Snell's law",
          "tex": "n_1\\sin i=n_2\\sin r",
          "unit": "dimensionless"
        },
        {
          "label": "Critical angle",
          "tex": "\\sin C=\\frac{n_2}{n_1}\\quad(n_1>n_2)",
          "unit": "dimensionless"
        },
        {
          "label": "Lens formula",
          "tex": "\\frac1f=\\frac1v-\\frac1u",
          "unit": "m^{-1}"
        },
        {
          "label": "Lens magnification",
          "tex": "m=\\frac{h_i}{h_o}=\\frac vu",
          "unit": "dimensionless"
        },
        {
          "label": "Lens maker's formula",
          "tex": "\\frac1f=(\\mu-1)\\left(\\frac1{R_1}-\\frac1{R_2}\\right)",
          "unit": "m^{-1}"
        },
        {
          "label": "Power of lens",
          "tex": "P=\\frac1f",
          "unit": "D"
        },
        {
          "label": "Lenses in contact",
          "tex": "P=P_1+P_2+\\cdots",
          "unit": "D"
        },
        {
          "label": "Prism relation",
          "tex": "A= r_1+r_2",
          "unit": "rad"
        },
        {
          "label": "Minimum deviation",
          "tex": "\\delta_m=i+e-A\\quad\\text{and for minimum deviation }i=e",
          "unit": "rad"
        },
        {
          "label": "Lens combination in contact",
          "tex": "\\frac1F=\\frac1{f_1}+\\frac1{f_2}+\\cdots",
          "unit": "m⁻¹"
        }
      ]
    },
    {
      "id": "c12-phy-10",
      "formulas": [
        {
          "label": "Young's double-slit fringe width",
          "tex": "\\beta=\\frac{\\lambda D}{d}",
          "unit": "m"
        },
        {
          "label": "Path difference",
          "tex": "\\Delta=d\\sin\\theta\\approx\\frac{dy}{D}",
          "unit": "m"
        },
        {
          "label": "Constructive interference",
          "tex": "\\Delta=n\\lambda",
          "unit": "m"
        },
        {
          "label": "Destructive interference",
          "tex": "\\Delta=\\left(n+\\frac12\\right)\\lambda",
          "unit": "m"
        },
        {
          "label": "Single-slit diffraction minima",
          "tex": "a\\sin\\theta=n\\lambda,\\quad n=1,2,3,\\ldots",
          "unit": "m"
        },
        {
          "label": "Fringe position",
          "tex": "y_n=\\frac{n\\lambda D}{d}",
          "unit": "m"
        }
      ]
    },
    {
      "id": "c12-phy-11",
      "formulas": [
        {
          "label": "Einstein photoelectric equation",
          "tex": "h\\nu=\\phi+K_{\\max}=\\phi+eV_0",
          "unit": "J"
        },
        {
          "label": "Work function",
          "tex": "\\phi=h\\nu_0",
          "unit": "J"
        },
        {
          "label": "de Broglie wavelength",
          "tex": "\\lambda=\\frac hp=\\frac{h}{mv}",
          "unit": "m"
        }
      ]
    },
    {
      "id": "c12-phy-12",
      "formulas": [
        {
          "label": "Bohr angular momentum",
          "tex": "mvr=\\frac{nh}{2\\pi}",
          "unit": "J s"
        },
        {
          "label": "Bohr radius",
          "tex": "r_n=\\frac{n^2a_0}{Z}",
          "unit": "m"
        },
        {
          "label": "Hydrogen energy",
          "tex": "E_n=-\\frac{13.6Z^2}{n^2}\\ \\mathrm{eV}",
          "unit": "eV"
        },
        {
          "label": "Rydberg relation",
          "tex": "\\frac1\\lambda=RZ^2\\left(\\frac1{n_1^2}-\\frac1{n_2^2}\\right)",
          "unit": "m^{-1}"
        },
        {
          "label": "Bohr orbit velocity",
          "tex": "v_n=\\frac{1}{4\\pi\\varepsilon_0}\\frac{Ze^2}{\\hbar n}",
          "unit": "m s⁻¹"
        },
        {
          "label": "Transition energy",
          "tex": "\\Delta E=E_{n_2}-E_{n_1}=h\\nu=\\frac{hc}{\\lambda}",
          "unit": "J"
        }
      ]
    },
    {
      "id": "c12-phy-13",
      "formulas": [
        {
          "label": "Mass-energy relation",
          "tex": "E=mc^2",
          "unit": "J"
        },
        {
          "label": "Mass defect",
          "tex": "\\Delta m=Zm_p+(A-Z)m_n-m_{\\rm nucleus}",
          "unit": "u"
        },
        {
          "label": "Binding energy",
          "tex": "B=\\Delta mc^2",
          "unit": "J"
        },
        {
          "label": "Binding energy in MeV",
          "tex": "B(\\mathrm{MeV})=\\Delta m(\\mathrm u)\\times931.5",
          "unit": "MeV"
        }
      ]
    }
  ]
}