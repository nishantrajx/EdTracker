{
  "subject": "c12-pe",
  "chapters": [
    {
      "id": "c12-pe-01",
      "formulas": [
        {
          "label": "Knock-out tournament matches",
          "tex": "\\text{Matches}=N-1",
          "unit": "matches"
        },
        {
          "label": "Number of byes",
          "tex": "\\text{Byes}=2^m-N\\quad\\text{where }2^m\\ge N",
          "unit": "byes"
        },
        {
          "label": "Single league matches",
          "tex": "\\text{Matches}=\\frac{N(N-1)}{2}",
          "unit": "matches"
        },
        {
          "label": "Double league matches",
          "tex": "\\text{Matches}=N(N-1)",
          "unit": "matches"
        }
      ]
    },
    {
      "id": "c12-pe-06",
      "formulas": [
        {
          "label": "Body Mass Index",
          "tex": "\\mathrm{BMI}=\\frac{\\text{body mass (kg)}}{[\\text{height (m)}]^2}",
          "unit": "kg m^{-2}"
        },
        {
          "label": "Waist-hip ratio",
          "tex": "\\mathrm{WHR}=\\frac{\\text{waist circumference}}{\\text{hip circumference}}",
          "unit": "dimensionless"
        }
      ]
    }
  ]
}