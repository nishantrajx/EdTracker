      "id": "c12-pe-01",
      "formulas": [
        {
          "label": "Knock-out tournament matches",
          "tex": "\\text{Matches}=N-1",
          "unit": "matches"
        },
        {
          "label": "Number of teams in upper half (odd N)",
          "tex": "\\text{Upper half}=\\frac{N+1}{2}",
          "unit": "teams"
        },
        {
          "label": "Number of teams in lower half (odd N)",
          "tex": "\\text{Lower half}=\\frac{N-1}{2}",
          "unit": "teams"
        },
        {
          "label": "Number of byes",
          "tex": "\\text{Byes}=2^m-N\\quad\\text{where }2^m\\ge N",
          "unit": "byes"
        },
        {
          "label": "Byes in upper half (odd number of byes)",
          "tex": "\\text{Upper-half byes}=\\frac{B-1}{2}",
          "unit": "byes; B = total number of byes"
        },
        {
          "label": "Byes in lower half (odd number of byes)",
          "tex": "\\text{Lower-half byes}=\\frac{B+1}{2}",
          "unit": "byes; B = total number of byes"
        },
        {
          "label": "Teams in each half (even N)",
          "tex": "\\text{Teams in each half}=\\frac{N}{2}",
          "unit": "teams"
        },
        {
          "label": "Number of rounds in a knock-out tournament",
          "tex": "\\text{Rounds}=m\\quad\\text{where }2^m\\text{ is the next power of 2 at or above }N",
          "unit": "rounds"
        },
        {
          "label": "Single league matches",
          "tex": "\\text{Matches}=\\frac{N(N-1)}{2}",
          "unit": "matches"
        },
        {
          "label": "Double league matches",
          "tex": "\\text{Matches}=N(N-1)",
          "unit": "matches"
        },
        {
          "label": "Knock-out matches",
          "tex": "M=N-1",
          "unit": "matches"
        },
        {
          "label": "Number of rounds in knock-out",
          "tex": "R=m,\\quad 2^m\\ge N",
          "unit": "rounds"
        }
      ],
      "name": "Management of Sporting Events"
    },
