      "name": "Biomechanics and Sports",
      "formulas": [
        {
          "label": "Newton's second law",
          "tex": "F=ma",
          "unit": "force"
        },
        {
          "label": "Momentum",
          "tex": "p=mv",
          "unit": "momentum"
        },
        {
          "label": "Impulse",
          "tex": "J=\\Delta p=F\\Delta t",
          "unit": "impulse"
        },
        {
          "label": "Work",
          "tex": "W=Fd\\cos\\theta",
          "unit": "work"
        },
        {
          "label": "Power",
          "tex": "P=\\frac{W}{t}",
          "unit": "power"
        },
        {
          "label": "Kinetic energy",
          "tex": "KE=\\frac12mv^2",
          "unit": "energy"
        },
        {
          "label": "Torque",
          "tex": "\\tau=Fd\\sin\\theta",
          "unit": "torque"
        },
        {
          "label": "Linear velocity",
          "tex": "v=\\frac{d}{t}",
          "unit": "velocity"
        },
        {
          "label": "Acceleration",
          "tex": "a=\\frac{\\Delta v}{\\Delta t}",
          "unit": "acceleration"
        }
      ]
    },
