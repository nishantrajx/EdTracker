    {
      "id": "c10-sci-12",
      "formulas": [
        {
          "label": "Electric current",
          "tex": "I=\\frac{Q}{t}",
          "unit": "A"
        },
        {
          "label": "Potential difference",
          "tex": "V=\\frac{W}{Q}",
          "unit": "V"
        },
        {
          "label": "Ohm's law",
          "tex": "V=IR",
          "unit": "V"
        },
        {
          "label": "Resistance",
          "tex": "R=\\frac{V}{I}",
          "unit": "\\Omega"
        },
        {
          "label": "Resistance of a uniform conductor",
          "tex": "R=\\rho\\frac{l}{A}",
          "unit": "\\Omega"
        },
        {
          "label": "Resistivity",
          "tex": "\\rho=\\frac{RA}{l}",
          "unit": "\\Omega\\,m"
        },
        {
          "label": "Series resistance",
          "tex": "R_s=R_1+R_2+\\cdots+R_n",
          "unit": "\\Omega"
        },
        {
          "label": "Parallel resistance",
          "tex": "\\frac1{R_p}=\\frac1{R_1}+\\frac1{R_2}+\\cdots+\\frac1{R_n}",
          "unit": "\\Omega"
        },
        {
          "label": "Two resistors in parallel",
          "tex": "R_p=\\frac{R_1R_2}{R_1+R_2}",
          "unit": "\\Omega"
        },
        {
          "label": "Electrical work",
          "tex": "W=VIt",
          "unit": "J"
        },
        {
          "label": "Electrical power",
          "tex": "P=VI",
          "unit": "W"
        },
        {
          "label": "Power using Ohm's law",
          "tex": "P=I^2R=\\frac{V^2}{R}",
          "unit": "W"
        },
        {
          "label": "Electrical energy",
          "tex": "E=Pt=VIt",
          "unit": "J"
        },
        {
          "label": "Commercial unit of electrical energy",
          "tex": "1\\ \\mathrm{kWh}=3.6\\times10^6\\ \\mathrm{J}",
          "unit": "J"
        },
        {
          "label": "Heating effect of current",
          "tex": "H=I^2Rt",
          "unit": "J"
        }
      ]
    },
