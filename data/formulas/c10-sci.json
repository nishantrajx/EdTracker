    {
      "id": "c10-sci-09",
      "formulas": [
        {
          "label": "Mendelian dominant phenotype ratio",
          "tex": "3:1",
          "unit": ""
        },
        {
          "label": "Mendelian monohybrid genotypic ratio",
          "tex": "1:2:1",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-sci-11",
      "formulas": [
        {
          "label": "Law of reflection",
          "tex": "\\angle i=\\angle r",
          "unit": ""
        },
        {
          "label": "Mirror formula",
          "tex": "\\frac1f=\\frac1v+\\frac1u",
          "unit": ""
        },
        {
          "label": "Mirror magnification",
          "tex": "m=\\frac{h_i}{h_o}=-\\frac{v}{u}",
          "unit": ""
        },
        {
          "label": "Spherical mirror relation",
          "tex": "R=2f",
          "unit": ""
        },
        {
          "label": "Refractive index",
          "tex": "n=\\frac{c}{v}",
          "unit": ""
        },
        {
          "label": "Snell's law",
          "tex": "n_1\\sin i=n_2\\sin r",
          "unit": ""
        },
        {
          "label": "Relative refractive index",
          "tex": "n_{21}=\\frac{n_2}{n_1}=\\frac{v_1}{v_2}",
          "unit": ""
        },
        {
          "label": "Lens formula",
          "tex": "\\frac1f=\\frac1v-\\frac1u",
          "unit": ""
        },
        {
          "label": "Lens magnification",
          "tex": "m=\\frac{h_i}{h_o}=\\frac{v}{u}",
          "unit": ""
        },
        {
          "label": "Power of a lens",
          "tex": "P=\\frac1f",
          "unit": "D when f is in metres"
        }
      ]
    },
    {
      "id": "c10-sci-12",
      "formulas": []
    },
    {
      "id": "c10-sci-13",
      "formulas": [
        {
          "label": "Electric current",
          "tex": "I=\\frac{Q}{t}",
          "unit": "A"
        },
        {
          "label": "Potential difference",
          "tex": "V=\\frac{W}{Q}",
          "unit": "V"
        },
        {
          "label": "Ohm's law",
          "tex": "V=IR",
          "unit": "V"
        },
        {
          "label": "Resistance",
          "tex": "R=\\frac{V}{I}",
          "unit": "\\Omega"
        },
        {
          "label": "Resistance of a uniform conductor",
          "tex": "R=\\rho\\frac{l}{A}",
          "unit": "\\Omega"
        },
        {
          "label": "Resistivity",
          "tex": "\\rho=\\frac{RA}{l}",
          "unit": "\\Omega\\,m"
        },
        {
          "label": "Series resistance",
          "tex": "R_s=R_1+R_2+\\cdots+R_n",
          "unit": "\\Omega"
        },
        {
          "label": "Parallel resistance",
          "tex": "\\frac1{R_p}=\\frac1{R_1}+\\frac1{R_2}+\\cdots+\\frac1{R_n}",
          "unit": "\\Omega"
        },
        {
          "label": "Two resistors in parallel",
          "tex": "R_p=\\frac{R_1R_2}{R_1+R_2}",
          "unit": "\\Omega"
        },
        {
          "label": "Electrical work",
          "tex": "W=VIt",
          "unit": "J"
        },
        {
          "label": "Electrical power",
          "tex": "P=VI",
          "unit": "W"
        },
        {
          "label": "Power using Ohm's law",
          "tex": "P=I^2R=\\frac{V^2}{R}",
          "unit": "W"
        },
        {
          "label": "Electrical energy",
          "tex": "E=Pt=VIt",
          "unit": "J"
        },
        {
          "label": "Commercial unit of electrical energy",
          "tex": "1\\ \\mathrm{kWh}=3.6\\times10^6\\ \\mathrm{J}",
          "unit": "J"
        },
        {
          "label": "Heating effect of current",
          "tex": "H=I^2Rt",
          "unit": "J"
        }
      ]
    },
    {
      "id": "c10-sci-14",
      "formulas": [
        {
          "label": "Magnetic field around current-carrying conductor",
          "tex": "B\\propto I",
          "unit": ""
        },
        {
          "label": "Force on a current-carrying conductor",
          "tex": "F=BIl",
          "unit": "N (for conductor perpendicular to magnetic field)"
        },
        {
          "label": "AC frequency in India",
          "tex": "f=50\\ \\mathrm{Hz}",
          "unit": "Hz"
        },
        {
          "label": "AC time period",
          "tex": "T=\\frac1f",
          "unit": "s"
        }
      ]
    },
    {
      "id": "c10-sci-15",
      "formulas": [
        {
          "label": "Energy flow in an ecosystem",
          "tex": "\\text{Sun}\\rightarrow\\text{producers}\\rightarrow\\text{consumers}",
          "unit": ""
        },
        {
          "label": "Ten percent law",
          "tex": "\\text{Energy transferred to next trophic level}\\approx10\\%",
          "unit": ""
        }
      ]
    }
  ]
}