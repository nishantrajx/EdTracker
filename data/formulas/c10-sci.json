{
  "subject": "c10-sci",
  "chapters": [
    {
      "id": "c10-sci-01",
      "formulas": [
        {
          "label": "General balanced chemical equation",
          "tex": "\\text{Reactants}\\rightarrow\\text{Products}",
          "unit": ""
        },
        {
          "label": "Combination reaction pattern",
          "tex": "A+B\\rightarrow AB",
          "unit": ""
        },
        {
          "label": "Decomposition reaction pattern",
          "tex": "AB\\rightarrow A+B",
          "unit": ""
        },
        {
          "label": "Displacement reaction pattern",
          "tex": "A+BC\\rightarrow AC+B",
          "unit": ""
        },
        {
          "label": "Double displacement reaction pattern",
          "tex": "AB+CD\\rightarrow AD+CB",
          "unit": ""
        },
        {
          "label": "Oxidation",
          "tex": "\\text{Addition of oxygen or removal of hydrogen}",
          "unit": ""
        },
        {
          "label": "Reduction",
          "tex": "\\text{Removal of oxygen or addition of hydrogen}",
          "unit": ""
        },
        {
          "label": "Redox reaction",
          "tex": "\\text{Oxidation and reduction occur simultaneously}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-sci-06",
      "formulas": [
        {
          "label": "Photosynthesis",
          "tex": "\\mathrm{6CO_2+6H_2O\\xrightarrow{light,\\ chlorophyll}C_6H_{12}O_6+6O_2}",
          "unit": ""
        },
        {
          "label": "Aerobic respiration",
          "tex": "\\mathrm{C_6H_{12}O_6+6O_2\\rightarrow6CO_2+6H_2O+Energy}",
          "unit": ""
        },
        {
          "label": "Anaerobic respiration in yeast",
          "tex": "\\mathrm{C_6H_{12}O_6\\rightarrow2C_2H_5OH+2CO_2+Energy}",
          "unit": ""
        },
        {
          "label": "Anaerobic respiration in muscles",
          "tex": "\\mathrm{C_6H_{12}O_6\\rightarrow2C_3H_6O_3+Energy}",
          "unit": ""
        }
      ]
    },
