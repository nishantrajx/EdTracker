          "label": "Natural selection",
          "tex": "\\text{Heritable variation + differential survival/reproduction}\\rightarrow\\text{change in population}",
          "unit": ""
        },
        {
          "label": "Speciation factors",
          "tex": "\\text{Variation + isolation + selection}\\rightarrow\\text{new species}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-sci-10",
      "formulas": [
        {
          "label": "Law of reflection",
          "tex": "\\angle i=\\angle r",
          "unit": ""
        },
        {
          "label": "Mirror formula",
          "tex": "\\frac1f=\\frac1v+\\frac1u",
          "unit": "m"
        },
        {
          "label": "Mirror magnification",
          "tex": "m=\\frac{h_i}{h_o}=-\\frac{v}{u}",
          "unit": ""
        },
        {
          "label": "Spherical mirror relation",
          "tex": "R=2f",
          "unit": "m"
        },
        {
          "label": "Refractive index",
          "tex": "n=\\frac{c}{v}",
          "unit": ""
        },
        {
          "label": "Snell's law",
          "tex": "n_1\\sin i=n_2\\sin r",
          "unit": ""
        },
        {
          "label": "Relative refractive index",
          "tex": "n_{21}=\\frac{n_2}{n_1}=\\frac{v_1}{v_2}",
          "unit": ""
        },
        {
          "label": "Lens formula",
          "tex": "\\frac1f=\\frac1v-\\frac1u",
          "unit": "m"
        },
        {
          "label": "Lens magnification",
          "tex": "m=\\frac{h_i}{h_o}=\\frac{v}{u}",
          "unit": ""
        },
        {
          "label": "Power of a lens",
          "tex": "P=\\frac1f",
          "unit": "D when f is in metres"
        },
        {
          "label": "Power of combined lenses",
          "tex": "P=P_1+P_2+\\cdots",
          "unit": "D"
        },
        {
          "label": "Lens power with focal length in cm",
          "tex": "P=\\frac{100}{f(\\mathrm{cm})}",
          "unit": "D"
        }
      ]
    },
