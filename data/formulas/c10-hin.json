{
  "subject": "c10-hin",
  "chapters": [
    {
      "id": "c10-hin-01",
      "formulas": [
        {
          "label": "अपठित गद्यांश पढ़ने का नियम",
          "tex": "\\text{प्रश्नों के उत्तर केवल दिए गए गद्यांश के आधार पर दें}",
          "unit": ""
        },
        {
          "label": "अपठित काव्यांश पढ़ने का नियम",
          "tex": "\\text{भावार्थ और उत्तर काव्यांश के संदर्भ में दें}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-02",
      "formulas": [
        {
          "label": "उपमा अलंकार",
          "tex": "\\text{उपमेय की उपमान से समानता/तुलना; वाचक शब्द जैसे 'सा', 'समान', 'जैसे' हो सकते हैं}",
          "unit": ""
        },
        {
          "label": "रूपक अलंकार",
          "tex": "\\text{उपमेय पर उपमान का अभेद आरोप}",
          "unit": ""
        },
        {
          "label": "उत्प्रेक्षा अलंकार",
          "tex": "\\text{उपमेय में उपमान की संभावना; 'मानो', 'जनु', 'जानो' आदि संकेतक हो सकते हैं}",
          "unit": ""
        },
        {
          "label": "अतिशयोक्ति अलंकार",
          "tex": "\\text{किसी बात का लोक-सीमा से बहुत अधिक बढ़ाकर वर्णन}",
          "unit": ""
        },
        {
          "label": "मानवीकरण अलंकार",
          "tex": "\\text{मानवेतर वस्तु/प्रकृति को मानवीय गुण देना}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-03",
      "formulas": [
        {
          "label": "नेताजी का चश्मा — अध्ययन सूत्र",
          "tex": "\\text{पात्र + घटना + व्यंग्य/भाव + शीर्षक की सार्थकता}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-04",
      "formulas": [
        {
          "label": "बालगोबिन भगत — अध्ययन सूत्र",
          "tex": "\\text{चरित्र + जीवन-मूल्य + लोकजीवन + लेखक की दृष्टि}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-05",
      "formulas": [
        {
          "label": "लखनवी अंदाज़ — अध्ययन सूत्र",
          "tex": "\\text{व्यवहार + दिखावा + हास्य/व्यंग्य + सामाजिक संकेत}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-07",
      "formulas": [
        {
          "label": "एक कहानी यह भी — अध्ययन सूत्र",
          "tex": "\\text{आत्मकथात्मक प्रसंग + संघर्ष + व्यक्तित्व + सामाजिक/पारिवारिक संदर्भ}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-09",
      "formulas": [
        {
          "label": "नौबतखाने में इबादत — अध्ययन सूत्र",
          "tex": "\\text{संगीत + साधना + सांस्कृतिक समन्वय + कलाकार का व्यक्तित्व}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-10",
      "formulas": [
        {
          "label": "संस्कृति — अध्ययन सूत्र",
          "tex": "\\text{संस्कृति बनाम सभ्यता + मानवीय मूल्यों + सृजनात्मकता}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-11",
      "formulas": [
        {
          "label": "पद – सूरदास — अध्ययन सूत्र",
          "tex": "\\text{भक्ति + कृष्ण-प्रेम + विरह/भाव + ब्रजभाषा}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-12",
      "formulas": [
        {
          "label": "राम-लक्ष्मण-परशुराम संवाद — अध्ययन सूत्र",
          "tex": "\\text{संवाद + वीर/रौद्र भाव + पात्र-स्वभाव + भाषा-शैली}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-14",
      "formulas": [
        {
          "label": "आत्मकथ्य — अध्ययन सूत्र",
          "tex": "\\text{कवि की आत्मानुभूति + जीवन-दृष्टि + काव्यात्मक अभिव्यक्ति}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-15",
      "formulas": [
        {
          "label": "उत्साह — अध्ययन सूत्र",
          "tex": "\\text{उत्साह + जागरण + प्रकृति-चित्रण + भाव}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-16",
      "formulas": [
        {
          "label": "अट नहीं रही है — अध्ययन सूत्र",
          "tex": "\\text{प्रकृति-सौंदर्य + रंग/दृश्य-बिंब + भावात्मक प्रभाव}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-17",
      "formulas": [
        {
          "label": "यह दंतुरित मुस्कान — अध्ययन सूत्र",
          "tex": "\\text{बाल-सौंदर्य + वात्सल्य + मुस्कान का प्रभाव}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-18",
      "formulas": [
        {
          "label": "फसल — अध्ययन सूत्र",
          "tex": "\\text{कृषि + श्रम + प्रकृति + सामूहिक योगदान}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-21",
      "formulas": [
        {
          "label": "संगतकार — अध्ययन सूत्र",
          "tex": "\\text{मुख्य कलाकार + सहायक कलाकार + श्रम/त्याग + सामूहिकता}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-22",
      "formulas": [
        {
          "label": "माता का आँचल — अध्ययन सूत्र",
          "tex": "\\text{बालमन + मातृत्व + ग्रामीण जीवन + पारिवारिक स्नेह}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-24",
      "formulas": [
        {
          "label": "साना-साना हाथ जोड़ि — अध्ययन सूत्र",
          "tex": "\\text{यात्रा-वृत्तांत + प्रकृति + स्थानीय जीवन + मानवीय संवेदना}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-26",
      "formulas": [
        {
          "label": "मैं क्यों लिखता हूँ? — अध्ययन सूत्र",
          "tex": "\\text{लेखन का उद्देश्य + अनुभव + अभिव्यक्ति + सामाजिक संदर्भ}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c10-hin-27",
      "formulas": [
        {
          "label": "अनुच्छेद लेखन",
          "tex": "\\text{भूमिका}\\rightarrow\\text{मुख्य विचार/तर्क}\\rightarrow\\text{उदाहरण/विस्तार}\\rightarrow\\text{निष्कर्ष}",
          "unit": ""
        },
        {
          "label": "औपचारिक पत्र",
          "tex": "\\text{पता/दिनांक}\\rightarrow\\text{प्राप्तकर्ता}\\rightarrow\\text{विषय}\\rightarrow\\text{मुख्य भाग}\\rightarrow\\text{समापन}",
          "unit": ""
        },
        {
          "label": "स्ववृत्त / आवेदन",
          "tex": "\\text{व्यक्तिगत विवरण}\\rightarrow\\text{शैक्षिक/योग्यता विवरण}\\rightarrow\\text{अनुभव/कौशल}\\rightarrow\\text{अन्य आवश्यक विवरण}",
          "unit": ""
        },
        {
          "label": "ई-मेल",
          "tex": "\\text{प्राप्तकर्ता}\\rightarrow\\text{विषय}\\rightarrow\\text{संबोधन}\\rightarrow\\text{संदेश}\\rightarrow\\text{समापन}",
          "unit": ""
        },
        {
          "label": "विज्ञापन",
          "tex": "\\text{शीर्षक}\\rightarrow\\text{मुख्य सूचना}\\rightarrow\\text{विशेषता/आवश्यकता}\\rightarrow\\text{संपर्क विवरण}",
          "unit": ""
        },
        {
          "label": "संदेश",
          "tex": "\\text{प्राप्तकर्ता/संदर्भ}\\rightarrow\\text{मुख्य सूचना}\\rightarrow\\text{आवश्यक समय/स्थान/कार्य}\\rightarrow\\text{प्रेषक}",
          "unit": ""
        }
      ]
    }
  ]
}
