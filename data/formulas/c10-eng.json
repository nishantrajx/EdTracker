          "tex": "\\text{Reporting verb}+\\text{object}+\\text{to/not to}+\\text{base verb}",
          "unit": ""
        },
        {
          "label": "Reported statement",
          "tex": "\\text{Reporting clause}+\\text{that}+\\text{reported clause}",
          "unit": ""
        },
        {
          "label": "Reported question",
          "tex": "\\text{Reporting verb}+\\text{if/whether or wh-word}+\\text{statement word order}",
          "unit": ""
        },
        {
          "label": "Backshift in reported speech",
          "tex": "\\text{Present}\\rightarrow\\text{Past};\\quad\\text{Past}\\rightarrow\\text{Past Perfect, where required by context}",
          "unit": ""
        },
