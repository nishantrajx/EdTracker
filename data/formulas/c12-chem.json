{
  "subject": "c12-chem",
  "chapters": [
    {
      "id": "c12-chem-01",
      "formulas": [
        {
          "label": "Molarity",
          "tex": "M=\\frac{\\text{moles of solute}}{\\text{volume of solution in L}}",
          "unit": "mol L^{-1}"
        },
        {
          "label": "Molality",
          "tex": "m=\\frac{\\text{moles of solute}}{\\text{mass of solvent in kg}}",
          "unit": "mol kg^{-1}"
        },
        {
          "label": "Mole fraction",
          "tex": "x_i=\\frac{n_i}{\\sum_j n_j}",
          "unit": "dimensionless"
        },
        {
          "label": "Raoult's law",
          "tex": "p_i=x_i p_i^0",
          "unit": "pressure"
        },
        {
          "label": "Relative lowering of vapour pressure",
          "tex": "\\frac{p^0-p}{p^0}=x_{\\rm solute}",
          "unit": "dimensionless"
        },
        {
          "label": "Elevation in boiling point",
          "tex": "\\Delta T_b=K_bm",
          "unit": "K"
        },
        {
          "label": "Depression in freezing point",
          "tex": "\\Delta T_f=K_fm",
          "unit": "K"
        },
        {
          "label": "Osmotic pressure",
          "tex": "\\pi=CRT=\\frac{nRT}{V}",
          "unit": "Pa"
        },
        {
          "label": "van't Hoff factor",
          "tex": "i=\\frac{\\text{observed colligative property}}{\\text{calculated colligative property}}",
          "unit": "dimensionless"
        },
        {
          "label": "Modified colligative relations",
          "tex": "\\Delta T_b=iK_bm,\\quad\\Delta T_f=iK_fm,\\quad\\pi=iCRT",
          "unit": "varies"
        }
      ]
    },
    {
      "id": "c12-chem-02",
      "formulas": [
        {
          "label": "Cell EMF",
          "tex": "E_{\\rm cell}=E_{\\rm cathode}-E_{\\rm anode}",
          "unit": "V"
        },
        {
          "label": "Nernst equation at 298 K",
          "tex": "E=E^\\circ-\\frac{0.0591}{n}\\log Q",
          "unit": "V"
        },
        {
          "label": "Gibbs energy and cell potential",
          "tex": "\\Delta G=-nFE_{\\rm cell}",
          "unit": "J mol^{-1}"
        },
        {
          "label": "Standard Gibbs energy",
          "tex": "\\Delta G^\\circ=-nFE^\\circ_{\\rm cell}",
          "unit": "J mol^{-1}"
        },
        {
          "label": "Conductance",
          "tex": "G=\\frac1R",
          "unit": "S"
        },
        {
          "label": "Conductivity",
          "tex": "\\kappa=G\\frac{l}{A}",
          "unit": "S m^{-1}"
        },
        {
          "label": "Molar conductivity",
          "tex": "\\Lambda_m=\\frac{\\kappa\\times1000}{C}",
          "unit": "S cm^2 mol^{-1}"
        },
        {
          "label": "Faraday law of electrolysis",
          "tex": "m=\\frac{MIt}{nF}",
          "unit": "g"
        },
        {
          "label": "Kohlrausch's law",
          "tex": "\\Lambda_m^\\circ=\\nu_+\\lambda_+^\\circ+\\nu_-\\lambda_-^\\circ",
          "unit": "S cm² mol⁻¹"
        }
      ]
    },
    {
      "id": "c12-chem-03",
      "formulas": [
        {
          "label": "Rate law",
          "tex": "r=k[A]^m[B]^n",
          "unit": "concentration time^{-1}"
        },
        {
          "label": "Zero-order integrated law",
          "tex": "[A]_t=[A]_0-kt",
          "unit": "mol L^{-1}"
        },
        {
          "label": "Zero-order half-life",
          "tex": "t_{1/2}=\\frac{[A]_0}{2k}",
          "unit": "time"
        },
        {
          "label": "First-order integrated law",
          "tex": "k=\\frac{2.303}{t}\\log\\frac{[A]_0}{[A]_t}",
          "unit": "time^{-1}"
        },
        {
          "label": "First-order half-life",
          "tex": "t_{1/2}=\\frac{0.693}{k}",
          "unit": "time"
        },
        {
          "label": "Arrhenius equation",
          "tex": "k=Ae^{-E_a/(RT)}",
          "unit": "—"
        },
        {
          "label": "Two-temperature Arrhenius form",
          "tex": "\\log\\frac{k_2}{k_1}=\\frac{E_a}{2.303R}\\left(\\frac1{T_1}-\\frac1{T_2}\\right)",
          "unit": "—"
        }
      ]
    },
    {
      "id": "c12-chem-04",
      "formulas": [
        {
          "label": "Magnetic moment of transition ion",
          "tex": "\\mu=\\sqrt{n(n+2)}\\ \\mathrm{BM}",
          "unit": "BM"
        }
      ]
    },
    {
      "id": "c12-chem-05",
      "formulas": [
        {
          "label": "Magnetic moment of coordination compound",
          "tex": "\\mu=\\sqrt{n(n+2)}\\,\\mathrm{BM}",
          "unit": "BM"
        }
      ]
    },
    {
      "id": "c12-chem-06",
      "formulas": [
        {
          "label": "Wurtz reaction",
          "tex": "2R-X+2Na\\xrightarrow{\\text{dry ether}}R-R+2NaX",
          "unit": ""
        },
        {
          "label": "Finkelstein reaction",
          "tex": "R-Cl/R-Br+NaI\\xrightarrow{\\text{acetone}}R-I+NaCl/NaBr",
          "unit": ""
        },
        {
          "label": "Swarts reaction",
          "tex": "R-Cl/R-Br\\xrightarrow{\\text{metal fluoride}}R-F",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-chem-07",
      "formulas": [
        {
          "label": "Williamson ether synthesis",
          "tex": "R-X+R'O^-Na^+\\rightarrow R-O-R'+NaX",
          "unit": ""
        },
        {
          "label": "Dehydration of alcohol",
          "tex": "R-CH_2CH_2OH\\xrightarrow{\\mathrm{conc.\\ H_2SO_4},\\ \\Delta}R-CH=CH_2+H_2O",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-chem-08",
      "formulas": [
        {
          "label": "Aldehyde oxidation",
          "tex": "R-CHO+[O]\\rightarrow R-COOH",
          "unit": ""
        },
        {
          "label": "Aldehyde reduction",
          "tex": "R-CHO+2[H]\\rightarrow R-CH_2OH",
          "unit": ""
        },
        {
          "label": "Ketone reduction",
          "tex": "R-CO-R'+2[H]\\rightarrow R-CH(OH)-R'",
          "unit": ""
        },
        {
          "label": "Esterification",
          "tex": "R-COOH+R'OH\\rightleftharpoons R-COOR'+H_2O",
          "unit": ""
        },
        {
          "label": "Decarboxylation",
          "tex": "R-COONa+NaOH\\xrightarrow{\\Delta,\\ \\mathrm{CaO}}R-H+Na_2CO_3",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-chem-09",
      "formulas": [
        {
          "label": "Carbylamine reaction",
          "tex": "R-NH_2+CHCl_3+3KOH\\rightarrow R-NC+3KCl+3H_2O",
          "unit": ""
        },
        {
          "label": "Diazotisation",
          "tex": "Ar-NH_2+NaNO_2+2HCl\\xrightarrow{273-278\\,K}Ar-N_2^+Cl^-+NaCl+2H_2O",
          "unit": ""
        },
        {
          "label": "Azo coupling",
          "tex": "Ar-N_2^+Cl^-+Ar'OH\\rightarrow Ar-N=N-Ar'+HCl",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-chem-10",
      "formulas": [
        {
          "label": "Peptide linkage",
          "tex": "\\mathrm{-CO-NH-}",
          "unit": ""
        }
      ]
    }
  ]
}