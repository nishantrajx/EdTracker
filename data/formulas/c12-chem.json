  "chapters": [
    {
      "id": "c12-chem-01",
      "formulas": [
        {
          "label": "Mass percentage",
          "tex": "\\text{Mass percentage}=\\frac{\\text{mass of solute}}{\\text{mass of solution}}\\times100",
          "unit": "%"
        },
        {
          "label": "Volume percentage",
          "tex": "\\text{Volume percentage}=\\frac{\\text{volume of solute}}{\\text{volume of solution}}\\times100",
          "unit": "%"
        },
        {
          "label": "Parts per million",
          "tex": "\\mathrm{ppm}=\\frac{\\text{parts of component}}{10^6\\text{ parts of solution}}",
          "unit": "dimensionless"
        },
        {
          "label": "Molarity",
          "tex": "M=\\frac{\\text{moles of solute}}{\\text{volume of solution in L}}",
          "unit": "mol L^{-1}"
        },
        {
          "label": "Molality",
          "tex": "m=\\frac{\\text{moles of solute}}{\\text{mass of solvent in kg}}",
          "unit": "mol kg^{-1}"
        },
        {
          "label": "Mole fraction",
          "tex": "x_i=\\frac{n_i}{\\sum_j n_j}",
          "unit": "dimensionless"
        },
        {
          "label": "Raoult's law",
          "tex": "p_i=x_i p_i^0",
          "unit": "pressure"
        },
        {
          "label": "Total vapour pressure",
          "tex": "p=x_1p_1^0+x_2p_2^0",
          "unit": "pressure"
        },
        {
          "label": "Relative lowering of vapour pressure",
          "tex": "\\frac{p^0-p}{p^0}=x_{\\rm solute}",
          "unit": "dimensionless"
        },
        {
          "label": "Henry's law",
          "tex": "p=K_Hx",
          "unit": "pressure"
        },
        {
          "label": "Elevation in boiling point",
          "tex": "\\Delta T_b=K_bm",
          "unit": "K"
        },
        {
          "label": "Depression in freezing point",
          "tex": "\\Delta T_f=K_fm",
          "unit": "K"
        },
        {
          "label": "Osmotic pressure",
          "tex": "\\pi=CRT=\\frac{nRT}{V}",
          "unit": "Pa"
        },
        {
          "label": "van't Hoff factor",
          "tex": "i=\\frac{\\text{observed colligative property}}{\\text{calculated colligative property}}",
          "unit": "dimensionless"
        },
        {
          "label": "Modified colligative relations",
          "tex": "\\Delta T_b=iK_bm,\\quad\\Delta T_f=iK_fm,\\quad\\pi=iCRT",
          "unit": "varies"
        },
        {
          "label": "van't Hoff factor for association",
          "tex": "i=1-\\alpha\\left(1-\\frac1n\\right)",
          "unit": "dimensionless"
        },
        {
          "label": "van't Hoff factor for dissociation",
          "tex": "i=1+\\alpha(n-1)",
          "unit": "dimensionless"
        },
        {
          "label": "Molarity in terms of mass",
          "tex": "M=\\frac{w_2/M_2}{V(\\mathrm L)}",
          "unit": "mol L^{-1}"
        },
        {
          "label": "Molality in terms of masses",
          "tex": "m=\\frac{w_2/M_2}{w_1(\\mathrm{kg})}",
          "unit": "mol kg^{-1}"
        },
        {
          "label": "Mole fraction of solute",
          "tex": "x_2=\\frac{n_2}{n_1+n_2}",
          "unit": "dimensionless"
        },
        {
          "label": "Mole fraction of solvent",
          "tex": "x_1=\\frac{n_1}{n_1+n_2}",
          "unit": "dimensionless"
        },
        {
          "label": "Mole-fraction sum",
          "tex": "x_1+x_2=1",
          "unit": "dimensionless"
        },
        {
          "label": "Molar mass from elevation of boiling point",
          "tex": "M_2=\\frac{K_b w_2\\times1000}{\\Delta T_b w_1}",
          "unit": "g mol^{-1}"
        },
        {
          "label": "Molar mass from depression of freezing point",
          "tex": "M_2=\\frac{K_f w_2\\times1000}{\\Delta T_f w_1}",
          "unit": "g mol^{-1}"
        },
        {
          "label": "Molar mass from osmotic pressure",
          "tex": "M_2=\\frac{w_2RT}{\\pi V}",
          "unit": "g mol^{-1}"
        }
      ]
    },
    {
      "id": "c12-chem-02",
      "formulas": [
        {
          "label": "Cell EMF",
          "tex": "E_{\\rm cell}=E_{\\rm cathode}-E_{\\rm anode}",
          "unit": "V"
        },
        {
          "label": "General Nernst equation",
          "tex": "E=E^\\circ-\\frac{RT}{nF}\\ln Q",
          "unit": "V"
        },
        {
          "label": "Nernst equation at 298 K",
          "tex": "E=E^\\circ-\\frac{0.0591}{n}\\log Q",
          "unit": "V"
        },
        {
          "label": "Gibbs energy and cell potential",
          "tex": "\\Delta G=-nFE_{\\rm cell}",
          "unit": "J mol^{-1}"
        },
        {
          "label": "Standard Gibbs energy",
          "tex": "\\Delta G^\\circ=-nFE^\\circ_{\\rm cell}",
          "unit": "J mol^{-1}"
        },
        {
          "label": "Standard potential and equilibrium constant",
          "tex": "\\Delta G^\\circ=-RT\\ln K=-nFE^\\circ_{\\rm cell}",
          "unit": "J mol^{-1}"
        },
        {
          "label": "Equilibrium constant at 298 K",
          "tex": "\\log K=\\frac{nE^\\circ_{\\rm cell}}{0.0591}",
          "unit": "dimensionless"
        },
        {
          "label": "Resistance",
          "tex": "R=\\rho\\frac{l}{A}",
          "unit": "\\Omega"
        },
        {
          "label": "Conductance",
          "tex": "G=\\frac1R",
          "unit": "S"
        },
        {
          "label": "Conductivity",
          "tex": "\\kappa=G\\frac{l}{A}",
          "unit": "S m^{-1}"
        },
        {
          "label": "Molar conductivity",
          "tex": "\\Lambda_m=\\frac{\\kappa\\times1000}{C}",
          "unit": "S cm^2 mol^{-1}"
        },
        {
          "label": "Faraday law of electrolysis",
          "tex": "m=\\frac{MIt}{nF}",
          "unit": "g"
        },
        {
          "label": "Kohlrausch's law",
          "tex": "\\Lambda_m^\\circ=\\nu_+\\lambda_+^\\circ+\\nu_-\\lambda_-^\\circ",
          "unit": "S cm² mol⁻¹"
        },
        {
          "label": "Conductivity-resistivity relation",
          "tex": "\\kappa=\\frac1\\rho",
          "unit": "S m^{-1}"
        },
        {
          "label": "Molar conductivity in SI concentration form",
          "tex": "\\Lambda_m=\\frac{\\kappa}{c}",
          "unit": "S m^2 mol^{-1}"
        },
        {
          "label": "Cell constant",
          "tex": "\\text{Cell constant}=\\frac{l}{A}",
          "unit": "m^{-1}"
        },
        {
          "label": "Faraday constant relation",
          "tex": "F=N_Ae",
          "unit": "C mol^{-1}"
        },
        {
          "label": "Standard EMF from standard Gibbs energy",
          "tex": "E^\\circ_{\\rm cell}=-\\frac{\\Delta G^\\circ}{nF}",
          "unit": "V"
        }
      ]
    },
    {
      "id": "c12-chem-03",
      "formulas": [
        {
          "label": "Average rate",
          "tex": "\\text{Average rate}=-\\frac{\\Delta[R]}{\\Delta t}=\\frac{\\Delta[P]}{\\Delta t}",
          "unit": "concentration time^{-1}"
        },
        {
          "label": "Instantaneous rate",
          "tex": "r=-\\frac{d[R]}{dt}=\\frac{d[P]}{dt}",
          "unit": "concentration time^{-1}"
        },
        {
          "label": "Rate law",
          "tex": "r=k[A]^m[B]^n",
          "unit": "concentration time^{-1}"
        },
        {
          "label": "Order of reaction",
          "tex": "\\text{Order}=m+n",
          "unit": "dimensionless"
        },
        {
          "label": "Zero-order integrated law",
          "tex": "[A]_t=[A]_0-kt",
          "unit": "mol L^{-1}"
        },
        {
          "label": "Zero-order rate constant",
          "tex": "k=\\frac{[A]_0-[A]_t}{t}",
          "unit": "mol L^{-1} time^{-1}"
        },
        {
          "label": "Zero-order half-life",
          "tex": "t_{1/2}=\\frac{[A]_0}{2k}",
          "unit": "time"
        },
        {
          "label": "First-order integrated law",
          "tex": "k=\\frac{2.303}{t}\\log\\frac{[A]_0}{[A]_t}",
          "unit": "time^{-1}"
        },
        {
          "label": "First-order concentration form",
          "tex": "[A]_t=[A]_0e^{-kt}",
          "unit": "mol L^{-1}"
        },
        {
          "label": "First-order half-life",
          "tex": "t_{1/2}=\\frac{0.693}{k}",
          "unit": "time"
        },
        {
          "label": "Arrhenius equation",
          "tex": "k=Ae^{-E_a/(RT)}",
          "unit": "—"
        },
        {
          "label": "Arrhenius logarithmic form",
          "tex": "\\log k=\\log A-\\frac{E_a}{2.303RT}",
          "unit": "—"
        },
        {
          "label": "Two-temperature Arrhenius form",
          "tex": "\\log\\frac{k_2}{k_1}=\\frac{E_a}{2.303R}\\left(\\frac1{T_1}-\\frac1{T_2}\\right)",
          "unit": "—"
        },
        {
          "label": "First-order rate constant (natural-log form)",
          "tex": "k=\\frac1t\\ln\\frac{[A]_0}{[A]_t}",
          "unit": "time^{-1}"
        },
        {
          "label": "First-order time-concentration relation",
          "tex": "\\ln\\frac{[A]_0}{[A]_t}=kt",
          "unit": "dimensionless"
        },
        {
          "label": "Activation energy from two rate constants",
          "tex": "E_a=\\frac{2.303R\\,\\log(k_2/k_1)}{(1/T_1)-(1/T_2)}",
          "unit": "J mol^{-1}"
        }
      ]
    },
