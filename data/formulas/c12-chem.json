     "label": "Tollens' test (silver mirror)",
     "tex": "\\mathrm{RCHO + 2[Ag(NH_3)_2]^+ + 3OH^-}\\rightarrow \\mathrm{RCOO^- + 2Ag\\downarrow + 4NH_3 + 2H_2O}"
    },
    {
     "label": "Fehling's test (red precipitate; aromatic aldehydes do not respond)",
     "tex": "\\mathrm{RCHO + 2Cu^{2+} + 5OH^-}\\rightarrow \\mathrm{RCOO^- + Cu_2O\\downarrow + 3H_2O}"
    },
    {
     "label": "Iodoform test (methyl ketones; yellow precipitate)",
     "tex": "\\mathrm{RCOCH_3 + 3I_2 + 4NaOH}\\rightarrow \\mathrm{CHI_3\\downarrow + RCOONa + 3NaI + 3H_2O}"
    },
