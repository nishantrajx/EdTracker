        {
          "label": "Direction cosines",
          "tex": "l=\\frac{a_x}{|\\vec a|},\\quad m=\\frac{a_y}{|\\vec a|},\\quad n=\\frac{a_z}{|\\vec a|},\\quad l^2+m^2+n^2=1",
          "unit": ""
