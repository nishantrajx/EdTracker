{
  "subject": "c12-math",
  "chapters": [
    {
      "id": "c12-math-02",
      "formulas": [
        {
          "label": "Principal inverse relations",
          "tex": "\\sin(\\sin^{-1}x)=x,\\quad \\cos(\\cos^{-1}x)=x,\\quad \\tan(\\tan^{-1}x)=x",
          "unit": ""
        },
        {
          "label": "Reciprocal inverse relations",
          "tex": "\\csc^{-1}x=\\sin^{-1}\\!\\left(\\frac1x\\right),\\quad \\sec^{-1}x=\\cos^{-1}\\!\\left(\\frac1x\\right),\\quad \\cot^{-1}x=\\tan^{-1}\\!\\left(\\frac1x\\right)",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-03",
      "formulas": [
        {
          "label": "Matrix multiplication",
          "tex": "(AB)_{ij}=\\sum_k a_{ik}b_{kj}",
          "unit": ""
        },
        {
          "label": "Transpose",
          "tex": "(A^T)^T=A",
          "unit": ""
        },
        {
          "label": "Transpose of a product",
          "tex": "(AB)^T=B^TA^T",
          "unit": ""
        },
        {
          "label": "Inverse of a product",
          "tex": "(AB)^{-1}=B^{-1}A^{-1}",
          "unit": ""
        },
        {
          "label": "Inverse matrix condition",
          "tex": "AA^{-1}=A^{-1}A=I",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-04",
      "formulas": [
        {
          "label": "2×2 determinant",
          "tex": "\\begin{vmatrix}a&b\\\\c&d\\end{vmatrix}=ad-bc",
          "unit": ""
        },
        {
          "label": "3×3 determinant",
          "tex": "\\begin{vmatrix}a&b&c\\\\d&e&f\\\\g&h&i\\end{vmatrix}=a(ei-fh)-b(di-fg)+c(dh-eg)",
          "unit": ""
        },
        {
          "label": "Adjoint-inverse relation",
          "tex": "A^{-1}=\\frac{\\operatorname{adj}A}{|A|},\\qquad |A|\\ne0",
          "unit": ""
        },
        {
          "label": "Area of triangle",
          "tex": "\\Delta=\\frac12\\left|x_1(y_2-y_3)+x_2(y_3-y_1)+x_3(y_1-y_2)\\right|",
          "unit": ""
        },
        {
          "label": "Inverse-matrix solution of linear equations",
          "tex": "AX=B\\Rightarrow X=A^{-1}B\\quad\\text{when }A^{-1}\\text{ exists}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-05",
      "formulas": [
        {
          "label": "Chain rule",
          "tex": "\\frac{dy}{dx}=\\frac{dy}{du}\\frac{du}{dx}",
          "unit": ""
        },
        {
          "label": "Inverse-trig derivatives: sin and cos",
          "tex": "\\frac{d}{dx}\\sin^{-1}x=\\frac1{\\sqrt{1-x^2}},\\quad \\frac{d}{dx}\\cos^{-1}x=-\\frac1{\\sqrt{1-x^2}}",
          "unit": ""
        },
        {
          "label": "Inverse-trig derivatives: sec and csc",
          "tex": "\\frac{d}{dx}\\sec^{-1}x=\\frac{1}{|x|\\sqrt{x^2-1}},\\quad \\frac{d}{dx}\\csc^{-1}x=-\\frac{1}{|x|\\sqrt{x^2-1}}",
          "unit": ""
        },
        {
          "label": "Inverse-trig derivative: cot",
          "tex": "\\frac{d}{dx}\\cot^{-1}x=-\\frac{1}{1+x^2}",
          "unit": ""
        },
        {
          "label": "Inverse-trig derivative: tan",
          "tex": "\\frac{d}{dx}\\tan^{-1}x=\\frac1{1+x^2}",
          "unit": ""
        },
        {
          "label": "Exponential and logarithmic derivatives",
          "tex": "\\frac{d}{dx}e^x=e^x,\\quad \\frac{d}{dx}a^x=a^x\\ln a,\\quad \\frac{d}{dx}\\ln x=\\frac1x",
          "unit": ""
        },
        {
          "label": "Logarithmic differentiation",
          "tex": "\\frac{d}{dx}\\ln y=\\frac1y\\frac{dy}{dx}",
          "unit": ""
        },
        {
          "label": "Parametric derivative",
          "tex": "\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}",
          "unit": ""
        },
        {
          "label": "Second derivative",
          "tex": "\\frac{d^2y}{dx^2}=\\frac{d}{dx}\\left(\\frac{dy}{dx}\\right)",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-06",
      "formulas": [
        {
          "label": "Critical point",
          "tex": "f'(x)=0\\quad\\text{or }f'(x)\\text{ is undefined}",
          "unit": ""
        },
        {
          "label": "Increasing function test",
          "tex": "f'(x)>0\\Rightarrow f(x)\\text{ is increasing}",
          "unit": ""
        },
        {
          "label": "Decreasing function test",
          "tex": "f'(x)<0\\Rightarrow f(x)\\text{ is decreasing}",
          "unit": ""
        },
        {
          "label": "Second derivative maximum test",
          "tex": "f'(a)=0,\\ f''(a)<0\\Rightarrow\\text{local maximum at }x=a",
          "unit": ""
        },
        {
          "label": "Second derivative minimum test",
          "tex": "f'(a)=0,\\ f''(a)>0\\Rightarrow\\text{local minimum at }x=a",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-07",
      "formulas": [
        {
          "label": "Basic integration relation",
          "tex": "\\int f(x)\\,dx=F(x)+C\\quad\\text{if }F'(x)=f(x)",
          "unit": ""
        },
        {
          "label": "Substitution",
          "tex": "\\int f(g(x))g'(x)\\,dx=\\int f(u)\\,du",
          "unit": ""
        },
        {
          "label": "Integration by parts",
          "tex": "\\int u\\,dv=uv-\\int v\\,du",
          "unit": ""
        },
        {
          "label": "Fundamental theorem",
          "tex": "\\int_a^b f(x)\\,dx=F(b)-F(a)",
          "unit": ""
        },
        {
          "label": "Definite-integral symmetry",
          "tex": "\\int_a^b f(x)\\,dx=\\int_a^b f(a+b-x)\\,dx",
          "unit": ""
        },
        {
          "label": "Even/odd symmetry",
          "tex": "\\int_{-a}^{a}f(x)\\,dx=2\\int_0^a f(x)\\,dx\\ (f\\text{ even})",
          "unit": ""
        },
        {
          "label": "Standard integral: 1/(x²+a²)",
          "tex": "\\int\\frac{dx}{x^2+a^2}=\\frac1a\\tan^{-1}\\frac{x}{a}+C",
          "unit": ""
        },
        {
          "label": "Standard integral: 1/(x²-a²)",
          "tex": "\\int\\frac{dx}{x^2-a^2}=\\frac1{2a}\\ln\\left|\\frac{x-a}{x+a}\\right|+C",
          "unit": ""
        },
        {
          "label": "Standard integral: 1/√(a²-x²)",
          "tex": "\\int\\frac{dx}{\\sqrt{a^2-x^2}}=\\sin^{-1}\\frac{x}{a}+C",
          "unit": ""
        },
        {
          "label": "Standard integral: 1/√(x²-a²)",
          "tex": "\\int\\frac{dx}{\\sqrt{x^2-a^2}}=\\ln\\left|x+\\sqrt{x^2-a^2}\\right|+C",
          "unit": ""
        },
        {
          "label": "Standard integral: 1/√(x²+a²)",
          "tex": "\\int\\frac{dx}{\\sqrt{x^2+a^2}}=\\ln\\left|x+\\sqrt{x^2+a^2}\\right|+C",
          "unit": ""
        },
        {
          "label": "Linear-over-quadratic integral",
          "tex": "\\int\\frac{px+q}{ax^2+bx+c}\\,dx\\quad\\text{(split using the derivative of the denominator)}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-08",
      "formulas": [
        {
          "label": "Area between curves",
          "tex": "A=\\int_a^b\\left[y_{\\text{upper}}-y_{\\text{lower}}\\right]dx",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-09",
      "formulas": [
        {
          "label": "Separation of variables",
          "tex": "\\frac{dy}{dx}=f(x)g(y)\\Rightarrow\\frac{dy}{g(y)}=f(x)\\,dx",
          "unit": ""
        },
        {
          "label": "Linear differential equation",
          "tex": "\\frac{dy}{dx}+Py=Q",
          "unit": ""
        },
        {
          "label": "Integrating factor",
          "tex": "\\operatorname{IF}=e^{\\int P\\,dx}",
          "unit": ""
        },
        {
          "label": "Solution of linear DE",
          "tex": "y\\,\\operatorname{IF}=\\int Q\\,\\operatorname{IF}\\,dx+C",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-10",
      "formulas": [
        {
          "label": "Magnitude of vector",
          "tex": "|\\vec a|=\\sqrt{a_x^2+a_y^2+a_z^2}",
          "unit": ""
        },
        {
          "label": "Unit vector",
          "tex": "\\hat a=\\frac{\\vec a}{|\\vec a|}",
          "unit": ""
        },
        {
          "label": "Section formula",
          "tex": "\\vec r=\\frac{m\\vec b+n\\vec a}{m+n}\\quad\\text{for internal division in ratio }m:n",
          "unit": ""
        },
        {
          "label": "Dot product",
          "tex": "\\vec a\\cdot\\vec b=|\\vec a||\\vec b|\\cos\\theta",
          "unit": ""
        },
        {
          "label": "Dot product in components",
          "tex": "\\vec a\\cdot\\vec b=a_xb_x+a_yb_y+a_zb_z",
          "unit": ""
        },
        {
          "label": "Cross-product magnitude",
          "tex": "|\\vec a\\times\\vec b|=|\\vec a||\\vec b|\\sin\\theta",
          "unit": ""
        },
        {
          "label": "Cross product in components",
          "tex": "\\vec a\\times\\vec b=\\begin{vmatrix}\\hat i&\\hat j&\\hat k\\\\a_x&a_y&a_z\\\\b_x&b_y&b_z\\end{vmatrix}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-11",
      "formulas": [
        {
          "label": "Line in vector form",
          "tex": "\\vec r=\\vec a+\\lambda\\vec b",
          "unit": ""
        },
        {
          "label": "Line in Cartesian form",
          "tex": "\\frac{x-x_1}{a}=\\frac{y-y_1}{b}=\\frac{z-z_1}{c}",
          "unit": ""
        },
        {
          "label": "Angle between two lines",
          "tex": "\\cos\\theta=\\frac{|a_1a_2+b_1b_2+c_1c_2|}{\\sqrt{a_1^2+b_1^2+c_1^2}\\sqrt{a_2^2+b_2^2+c_2^2}}",
          "unit": ""
        },
        {
          "label": "Shortest distance between skew lines",
          "tex": "d=\\frac{|(\\vec a_2-\\vec a_1)\\cdot(\\vec b_1\\times\\vec b_2)|}{|\\vec b_1\\times\\vec b_2|}",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-12",
      "formulas": [
        {
          "label": "Objective function",
          "tex": "Z=ax+by",
          "unit": ""
        }
      ]
    },
    {
      "id": "c12-math-13",
      "formulas": [
        {
          "label": "Conditional probability",
          "tex": "P(A\\mid B)=\\frac{P(A\\cap B)}{P(B)},\\quad P(B)>0",
          "unit": ""
        },
        {
          "label": "Multiplication theorem",
          "tex": "P(A\\cap B)=P(A)P(B\\mid A)=P(B)P(A\\mid B)",
          "unit": ""
        },
        {
          "label": "Independent events",
          "tex": "P(A\\cap B)=P(A)P(B)",
          "unit": ""
        },
        {
          "label": "Total probability",
          "tex": "P(A)=\\sum_i P(B_i)P(A\\mid B_i)",
          "unit": ""
        },
        {
          "label": "Bayes' theorem",
          "tex": "P(B_i\\mid A)=\\frac{P(B_i)P(A\\mid B_i)}{\\sum_jP(B_j)P(A\\mid B_j)}",
          "unit": ""
        }
      ]
    }
  ]
}