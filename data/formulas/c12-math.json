        },
        {
          "label": "Integrating factor with y as independent variable",
          "tex": "\\operatorname{IF}=e^{\\int P\\,dy}",
          "unit": ""
        },
        {
          "label": "General solution of separable DE",
          "tex": "\\int\\frac{dy}{g(y)}=\\int f(x)\\,dx+C",
