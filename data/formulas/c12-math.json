        {
          "label": "Separation of variables",
          "tex": "\\frac{dy}{dx}=f(x)g(y)\\Rightarrow\\frac{dy}{g(y)}=f(x)\\,dx",
          "unit": ""
        },
        {
          "label": "Homogeneous differential equation substitution",
          "tex": "\\frac{dy}{dx}=F\\!\\left(\\frac yx\\right),\\qquad y=vx",
